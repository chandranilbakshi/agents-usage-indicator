{
  "name": "agents-usage-indicator",
  "private": true,
  "type": "module",
  "scripts": {
    "build:zip": "UUID=agents-usage-indicator@didmar.github.io; rm -f \"$UUID.zip\"; glib-compile-schemas schemas/; zip -r \"$UUID.zip\" . -x 'node_modules/*' 'tests/*' '.git/*' '.gitignore' 'package.json' 'package-lock.json' 'eslint.config.js' '*.zip' 'install.sh' 'README.md' 'LICENSE' 'screenshot.png'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
